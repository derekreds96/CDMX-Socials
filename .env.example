# Supabase (Configuración > API en tu proyecto de Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Correo (Resend) — para enviar el boleto con QR
RESEND_API_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=

# Stripe (si se usa además/en lugar de Mercado Pago para tarjeta)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# URL pública del sitio (usada en redirects de pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
